 * Copyright(C) 2026 the KNLMeansVk contributors.
 *
 * GPLv3-or-later, like the OpenCL implementation it is ported from.
 *
 * The GPU-friendly NL-means decomposition follows B. Goossens, H.Q. Luong, J. Aelterman,
 * A. Pizurica and W. Philips, "A GPU-Accelerated Real-Time NLMeans Algorithm for Denoising
 * Color Video Sequences", Proc. ACIVS (2), 2010, pp. 46-57.
 *
 * Not a standalone shader: the host prepends "#version 460", the storage extensions and
 * these defines, then compiles the result once per kernel:
 *
 *   KNLM_KERNEL    0 zero, 1 pack, 2 weight, 3 accumulate, 4 finish
 *   KNLM_CHANNELS  1, 2 or 3 jointly filtered channels
 *   KNLM_FMT_FLOAT 1 for half/float clips, 0 for integer
 *   KNLM_MAX_BATCH search offsets a round can carry (the host batches up to this)
 *   SAMPLE_T       uint8_t / uint16_t / float16_t / float
 *
 * Everything that is a value rather than structure arrives as a specialization constant,
 * so two instances differing only in parameters share the same cached source text.
 *
 * The search runs in rounds of up to KNLM_MAX_BATCH offsets: one weight and one
 * accumulate dispatch cover the whole round, walking its pairs in a loop. Compared to one
 * offset per dispatch that divides the dispatch and barrier count by the batch size, and
 * the accumulators are read and written once per round instead of once per offset.
 * Weights of a round are summed in registers before touching U2, which only regroups the
 * float additions; every term is the same.
 *
 * The weight kernel is the whole of what the OpenCL implementation spread over three
 * kernels -- per-pixel distance, then a horizontal box, then a vertical one -- fused into
 * a single pass whose two intermediates live in shared memory. Structure borrowed from
 * dnjulek's CUDA vapoursynth-zipcu (MIT). The point is not the tiling: it is that a
 * separate box pass has to write a whole weight plane and read it back, and at three
 * passes per offset that traffic, not the arithmetic, was most of the run time.
 *
 * Scratch layout, in planes of scrStride * height elements:
 *   U1 stacks: 2*RADIUS+1 planes of U1VEC, a pixel's channels interleaved; layer RADIUS is
 *              the frame being produced. One stack for the clip, a second for rclip when
 *              given (distances read rclip, averages read the clip).
 *   U4:        2 float planes per batched offset; slot 0 is the +q weight field, slot 1
 *              the temporal mirror (unused when its qk is 0).
 *   U2:        one plane of U2VEC; the weighted sums, then the weight sum.
 *   U5:        1 float plane; the running maximum weight, seeding the centre pixel's.
 *
 * Spatial out-of-bounds reads are zero, reproducing the OpenCL CLK_ADDRESS_CLAMP border:
 * patches beyond the edge compare against black and their pixels contribute value zero.
 */

layout(local_size_x = 16, local_size_y = 16) in;

layout(constant_id = 0) const int REFMODE = 0;      /* 0 luma, 1 chroma, 2 yuv, 3 rgb */
layout(constant_id = 1) const int WMODE = 0;        /* 0 welsch, 1/2/3 bisquare a/b/c */
layout(constant_id = 2) const int PATCH = 4;        /* s: patch radius */
layout(constant_id = 3) const int RADIUS = 0;       /* d: temporal radius */
layout(constant_id = 4) const float H2_INV_NORM = 1.0;
layout(constant_id = 5) const float WREF = 1.0;
layout(constant_id = 6) const float DENORM = 255.0; /* integer max pixel value */
layout(constant_id = 7) const int ROWS = 2;         /* weight: output rows per thread */

#if KNLM_KERNEL >= 2 && KNLM_KERNEL <= 3

/* The search kernels: one round of up to KNLM_MAX_BATCH offsets per dispatch. */
layout(push_constant) uniform PC {
    int width, height;      /* processed plane, which every kernel dispatches over */
    int scrStride;          /* scratch row length in floats, fixed at creation */
    int numPairs;           /* offsets in this round */
    uint gateMask;          /* bit p clear: offset p skipped (clip edge cannot supply it) */
    int qx[KNLM_MAX_BATCH];
    int qy[KNLM_MAX_BATCH];
    int qk[KNLM_MAX_BATCH]; /* in [-RADIUS, 0] */
} pc;

#else

layout(push_constant) uniform PC {
    int width, height;      /* processed plane, which every kernel dispatches over */
    int scrStride;          /* scratch row length in floats, fixed at creation */
    int dstStride;          /* finish: output plane stride in samples */
    int srcStride0, srcStride1, srcStride2; /* pack: source plane strides in samples */
    int layer;              /* pack: stack layer; finish: channel */
} pc;

#endif

/* The per-frame plane area; layer/channel/slot indices scale it. */
#define PLANE_ELEMS (pc.scrStride * pc.height)

/* U2 holds its KNLM_CHANNELS+1 accumulators interleaved per pixel rather than as separate
   planes, so the accumulation reads and writes them as one vector instead of touching
   that many far-apart addresses. Widened to a power of two because std430 aligns a vec3
   to 16 bytes anyway, which makes the two-channel case a padded vec4 at no cost. */
#if KNLM_CHANNELS == 1
#  define U2VEC vec2
#  define U2W 2
#else
#  define U2VEC vec4
#  define U2W 4
#endif

/* The stacks stay one plane per channel. Interleaving them the way U2 is interleaved was
   measured and LOST: three channels have to be padded to a vec4 for the layout to address
   them, and moving a third more bytes per pixel costs more than gathering a pixel's
   channels in one transaction saves -- 88 fps against 110 on joint YUV and on RGB. */
#define U1VEC float
#define U1AT(layer, c, off) u1[((layer) * KNLM_CHANNELS + (c)) * PLANE_ELEMS + (off)]

#define FLT_EPS 1.1920928955078125e-7

#if KNLM_KERNEL == 0 /* ------------------------------------------------ zero U2 and U5 */

layout(std430, binding = 0) writeonly buffer BU2 { U2VEC u2[]; };
layout(std430, binding = 1) writeonly buffer BU5 { float u5[]; };

void main() {
    int x = int(gl_GlobalInvocationID.x), y = int(gl_GlobalInvocationID.y);
    if (x >= pc.width || y >= pc.height)
        return;
    int idx = y * pc.scrStride + x;
    u2[idx] = U2VEC(0.0);
    /* Epsilon rather than zero so a frame whose every weight underflows still divides. */
    u5[idx] = FLT_EPS;
}

#elif KNLM_KERNEL == 1 /* --------------------- pack one source frame into a stack layer */

layout(std430, binding = 0) readonly buffer BP0 { SAMPLE_T p0[]; };
#if KNLM_CHANNELS >= 2
layout(std430, binding = 1) readonly buffer BP1 { SAMPLE_T p1[]; };
#endif
#if KNLM_CHANNELS >= 3
layout(std430, binding = 2) readonly buffer BP2 { SAMPLE_T p2[]; };
#endif
layout(std430, binding = KNLM_CHANNELS) writeonly buffer BU1 { U1VEC u1[]; };

float normalize1(SAMPLE_T v) {
#if KNLM_FMT_FLOAT
    return float(v);
#else
    return float(v) / DENORM;
#endif
}

void main() {
    int x = int(gl_GlobalInvocationID.x), y = int(gl_GlobalInvocationID.y);
    if (x >= pc.width || y >= pc.height)
        return;
    int off = y * pc.scrStride + x;
    U1AT(pc.layer, 0, off) = normalize1(p0[y * pc.srcStride0 + x]);
#if KNLM_CHANNELS >= 2
    U1AT(pc.layer, 1, off) = normalize1(p1[y * pc.srcStride1 + x]);
#endif
#if KNLM_CHANNELS >= 3
    U1AT(pc.layer, 2, off) = normalize1(p2[y * pc.srcStride2 + x]);
#endif
}

#elif KNLM_KERNEL == 2 /* ---------- distance + separable box + weight, fused, one round */

layout(std430, binding = 0) readonly buffer BU1 { U1VEC u1[]; };
layout(std430, binding = 1) writeonly buffer BU4 { float u4[]; };

/* One tile of output pixels per workgroup, with a PATCH-wide halo of distances around it
   so the box sums never leave shared memory. Sized from the spec constants, so a small
   patch does not reserve room for the largest one.

   A thread owns ROWS output rows rather than one, which is what makes the halo cheap:
   the tile is TILE wide and TILE*ROWS tall, so the recomputed border shrinks from
   (TILE+2s)^2/TILE^2 of the useful work towards (TILE+2s)/TILE as ROWS grows. The host
   picks the largest ROWS whose shared memory fits the device. */
#define TILE 16
#define PADW (TILE + 2 * PATCH)
#define PADH (TILE * ROWS + 2 * PATCH)
shared float sdist[PADH * PADW];
shared float shsum[PADH * TILE];

float stackAt(int layer, int c, int xx, int yy) {
    if (uint(xx) >= uint(pc.width) || uint(yy) >= uint(pc.height))
        return 0.0;
    return U1AT(layer, c, yy * pc.scrStride + xx);
}

float channelDistance(int layerA, int layerB, int x, int y, int ox, int oy) {
    float a0 = stackAt(layerA, 0, x, y);
    float b0 = stackAt(layerB, 0, x + ox, y + oy);
    if (REFMODE == 0) {
        float d0 = a0 - b0;
        return 3.0 * d0 * d0;
    }
    float a1 = stackAt(layerA, 1, x, y);
    float b1 = stackAt(layerB, 1, x + ox, y + oy);
    if (REFMODE == 1) {
        float d0 = a0 - b0, d1 = a1 - b1;
        return 1.5 * (d0 * d0 + d1 * d1);
    }
    float a2 = stackAt(layerA, 2, x, y);
    float b2 = stackAt(layerB, 2, x + ox, y + oy);
    float d0 = a0 - b0, d1 = a1 - b1, d2 = a2 - b2;
    if (REFMODE == 2)
        return d0 * d0 + d1 * d1 + d2 * d2;
    /* RGB weights red and blue by brightness, as the OpenCL kernel did. */
    float mRed = (a0 + b0) / 6.0;
    return (2.0 / 3.0 + mRed) * d0 * d0 + (4.0 / 3.0) * d1 * d1 + (1.0 - mRed) * d2 * d2;
}

float weight1(float sum) {
    float v = sum * H2_INV_NORM;
    if (WMODE == 0)
        return exp(-v);
    float f = max(1.0 - v, 0.0);
    if (WMODE == 1)
        return f;
    if (WMODE == 2)
        return f * f;
    float f2 = f * f, f4 = f2 * f2;
    return f4 * f4;
}

void main() {
    /* No thread leaves early: every barrier below has to be reached by the whole group,
       and the tail workgroup of a plane holds threads outside it. Only the store is
       guarded. */
    int lx = int(gl_LocalInvocationID.x), ly = int(gl_LocalInvocationID.y);
    int lid = ly * TILE + lx;
    int bx = int(gl_WorkGroupID.x) * TILE, by = int(gl_WorkGroupID.y) * (TILE * ROWS);
    int gx = bx + lx;

    for (int p = 0; p < pc.numPairs; p++) {
        int slots = pc.qk[p] < 0 ? 2 : 1;
        for (int s = 0; s < slots; s++) {
            /* Slot 0 is this frame against the neighbour at +q; slot 1 the temporal
               mirror, the frame at -qk against this one, whose weight the accumulation
               reads back at (x - qx, y - qy). Slot 0 doubles for it when qk is 0. */
            int layerA = s == 0 ? RADIUS : RADIUS - pc.qk[p];
            int layerB = s == 0 ? RADIUS + pc.qk[p] : RADIUS;

            /* Distances for the tile and its halo. Out of bounds reads zero, which is
               the CLK_ADDRESS_CLAMP border the box sums were always written against. */
            barrier();
            for (int i = lid; i < PADH * PADW; i += TILE * TILE) {
                int sx = bx + (i % PADW) - PATCH, sy = by + (i / PADW) - PATCH;
                /* A halo position outside the plane contributes nothing to the box sum.
                   It has to be zeroed on the CENTRE, not left to the neighbour lookup:
                   at a nonzero offset the neighbour of an outside pixel can be inside,
                   which would feed the sum a distance the separate box pass never saw. */
                bool inside = uint(sx) < uint(pc.width) && uint(sy) < uint(pc.height);
                sdist[i] = inside
                    ? channelDistance(layerA, layerB, sx, sy, pc.qx[p], pc.qy[p]) : 0.0;
            }
            barrier();

            /* Horizontal sums over the halo's full height, output width only. */
            for (int i = lid; i < PADH * TILE; i += TILE * TILE) {
                int tx = i % TILE, ty = i / TILE;
                float sum = 0.0;
                for (int j = 0; j <= 2 * PATCH; j++)
                    sum += sdist[ty * PADW + tx + j];
                shsum[i] = sum;
            }
            barrier();

            for (int r = 0; r < ROWS; r++) {
                int ty = ly + r * TILE;
                int gy = by + ty;
                if (gx < pc.width && gy < pc.height) {
                    float sum = 0.0;
                    for (int j = 0; j <= 2 * PATCH; j++)
                        sum += shsum[(ty + j) * TILE + lx];
                    u4[(2 * p + s) * PLANE_ELEMS + gy * pc.scrStride + gx] = weight1(sum);
                }
            }
        }
    }
}

#elif KNLM_KERNEL == 3 /* ----------- accumulate both neighbours of every pair in a round */

layout(std430, binding = 0) readonly buffer BU1 { U1VEC u1[]; };
layout(std430, binding = 1) readonly buffer BU4 { float u4[]; };
layout(std430, binding = 2) buffer BU2 { U2VEC u2[]; };
layout(std430, binding = 3) buffer BU5 { float u5[]; };

float stackAt(int layer, int c, int xx, int yy) {
    if (uint(xx) >= uint(pc.width) || uint(yy) >= uint(pc.height))
        return 0.0;
    return U1AT(layer, c, yy * pc.scrStride + xx);
}

float weightAt(int plane, int xx, int yy) {
    if (uint(xx) >= uint(pc.width) || uint(yy) >= uint(pc.height))
        return 0.0;
    return u4[plane * PLANE_ELEMS + yy * pc.scrStride + xx];
}

void main() {
    int x = int(gl_GlobalInvocationID.x), y = int(gl_GlobalInvocationID.y);
    if (x >= pc.width || y >= pc.height)
        return;
    int idx = y * pc.scrStride + x;
    float acc[KNLM_CHANNELS + 1];
    for (int c = 0; c <= KNLM_CHANNELS; c++)
        acc[c] = 0.0;
    float wmax = u5[idx];
    for (int p = 0; p < pc.numPairs; p++) {
        /* An offset the clip edge cannot supply on both temporal sides contributes
           nothing; the search window shrinks symmetrically at the ends of the clip. */
        if ((pc.gateMask & (1u << p)) == 0u)
            continue;
        float w = u4[(2 * p) * PLANE_ELEMS + idx];
        /* The -q neighbour's weight is the one computed at p - q with offset +q: slot 0
           when the pair is spatial, the mirror slot when it spans time. */
        float wMq = weightAt(2 * p + (pc.qk[p] < 0 ? 1 : 0), x - pc.qx[p], y - pc.qy[p]);
        wmax = max(max(w, wMq), wmax);
        for (int c = 0; c < KNLM_CHANNELS; c++) {
            float uPq = stackAt(RADIUS + pc.qk[p], c, x + pc.qx[p], y + pc.qy[p]);
            float uMq = stackAt(RADIUS - pc.qk[p], c, x - pc.qx[p], y - pc.qy[p]);
            acc[c] += w * uPq + wMq * uMq;
        }
        acc[KNLM_CHANNELS] += w + wMq;
    }
    u5[idx] = wmax;
    /* One vector read-modify-write for the whole round's accumulators. */
    U2VEC v = u2[idx];
    for (int c = 0; c <= KNLM_CHANNELS; c++)
        v[c] += acc[c];
    u2[idx] = v;
}

#elif KNLM_KERNEL == 4 /* -------------------- weighted average out to one output plane */

layout(std430, binding = 0) readonly buffer BU1 { U1VEC u1[]; };
layout(std430, binding = 1) readonly buffer BU2 { U2VEC u2[]; };
layout(std430, binding = 2) readonly buffer BU5 { float u5[]; };
layout(std430, binding = 3) writeonly buffer BD { SAMPLE_T dst[]; };

void main() {
    int x = int(gl_GlobalInvocationID.x), y = int(gl_GlobalInvocationID.y);
    if (x >= pc.width || y >= pc.height)
        return;
    int idx = y * pc.scrStride + x;
    int c = pc.layer;
    float center = U1AT(RADIUS, c, idx);
    float m = WREF * u5[idx];
    U2VEC v = u2[idx];
    float den = m + v[KNLM_CHANNELS];
    float val = (center * m + v[c]) / den;
#if KNLM_FMT_FLOAT
    dst[y * pc.dstStride + x] = SAMPLE_T(val);
#else
    /* Round to nearest even and saturate, as the OpenCL convert_*_sat_rte did. */
    dst[y * pc.dstStride + x] = SAMPLE_T(uint(clamp(roundEven(val * DENORM), 0.0, DENORM)));
#endif
}

#endif
